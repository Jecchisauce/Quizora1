<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ADD8E6"
    tools:context=".QuizCreationFragment"
    android:id="@+id/fragment_container">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <Button
            android:id="@+id/back_button"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/save"
            android:contentDescription="backButton"
            android:paddingLeft="2dp"
            android:text="Back"
            android:textColor="@color/white"
            tools:ignore="TouchTargetSizeCheck"
            />

        <TextView
            android:id="@+id/QuizTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="16dp"

            android:fontFamily="@font/poppins_extrabold"
            android:text="Quiz name"
            android:textAlignment="center"
            android:textSize="18sp" />

        <Button
            android:id="@+id/save_quiz_button"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="end"
            android:layout_marginEnd="12dp"
            android:background="@drawable/save"
            android:paddingHorizontal="16dp"
            android:text="Save quiz"
            android:textColor="@color/white"
            tools:ignore="TouchTargetSizeCheck" />

    </androidx.appcompat.widget.Toolbar>

    <TextView
        android:id="@+id/empty_quiz_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:fontFamily="@font/poppins_extrabold"
        android:text="The Quiz content is Empty."
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar" />

    <Button
        android:id="@+id/create_question_button"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_margin="24dp"
        android:layout_marginTop="112dp"
        android:background="@color/white"
        android:fontFamily="@font/poppins_medium"

        android:text="Create Question"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.333"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/empty_quiz_text"
        app:layout_constraintVertical_bias="0.889" />

</androidx.constraintlayout.widget.ConstraintLayout>