<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="150dp"
    android:layout_height="180dp"
    android:padding="10dp"
    android:background="@drawable/back_bg"
    android:layout_margin="15dp">

    <TextView
        android:id="@+id/historyQuizTitle"
        android:textAlignment="center"
        android:layout_width="94dp"
        android:layout_height="29dp"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/poppins_medium"
        android:text="Quiz Title"
        android:textColor="@color/black"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/historyQuizScore"
        android:layout_width="93dp"
        android:layout_height="33dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/textbox"
        android:fontFamily="@font/poppins_medium"
        android:padding="6dp"
        android:text="Score: 8/10"
        android:textAlignment="center"
        android:textColor="@color/black"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.513"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/historyQuizTitle"
        app:layout_constraintVertical_bias="0.1" />

    <ImageView
        android:id="@+id/QuizImage"
        android:layout_width="86dp"
        android:layout_height="75dp"
        android:layout_marginTop="25dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ma_th"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/historyQuizScore"
        app:layout_constraintVertical_bias="1.0" />

</androidx.constraintlayout.widget.ConstraintLayout>
