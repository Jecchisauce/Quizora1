<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#411036"
    tools:context=".AnswerHistory">

    <!-- Click-blocking Full-Screen Overlay -->
    <View
        android:contentDescription="Screenblocker"
        android:id="@+id/overlay_blocker"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:focusable="true"/>

    <!-- Back Button at Top Left -->
    <Button
        android:id="@+id/History_backbtn"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|start"
        android:layout_margin="20dp"
        android:background="@drawable/back_bg"
        android:drawableLeft="@drawable/baseline_arrow_back_24"
        android:textSize="20sp"
        android:textColor="@android:color/white"
        android:fontFamily="@font/poppins_medium"
        android:contentDescription="back_button"/>

    <!-- Scoreboard at Top Right -->
    <TextView
        android:id="@+id/scoreboard"
        android:layout_width="156dp"
        android:layout_height="70dp"
        android:layout_gravity="top|end"
        android:layout_margin="10dp"
        android:background="@drawable/score_bg"
        android:fontFamily="@font/poppins_medium"
        android:gravity="center"
        android:padding="8dp"
        android:text="SCORE: 0"
        android:textColor="@android:color/white"
        android:textSize="18sp"/>




    <!-- Main Quiz Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Border around Quiz Content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/skip_border"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Quiz Title -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:fontFamily="@font/poppins_extrabold"
                android:paddingTop="8dp"
                android:text="HISTORY"
                android:textAlignment="center"
                android:textAllCaps="true"
                android:textColor="@color/black"
                android:textSize="26sp" />

            <!-- Timer Progress Bar -->
            <ProgressBar
                android:id="@+id/timer_progress"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginBottom="5dp"
                android:indeterminate="false"
                android:max="100"
                android:progress="100"
                android:progressDrawable="@drawable/timer" />

            <!-- Question Counter at Top Center -->

            <!-- Question Box -->
            <TextView
                android:id="@+id/question_counter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="right"
                android:layout_margin="5dp"
                android:background="@drawable/border"
                android:fontFamily="@font/poppins_medium"
                android:padding="10dp"
                android:text="Questions 1/10"
                android:textAlignment="center"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:ignore="RtlCompat" />

            <LinearLayout
                android:id="@+id/question_container"
                android:layout_width="match_parent"
                android:layout_height="137dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/textbox"
                android:orientation="vertical"
                android:paddingTop="15dp">

                <TextView
                    android:id="@+id/question_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/poppins_extrabold"
                    android:paddingLeft="20dp"
                    android:text="Question"
                    android:textColor="@color/black"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Answer Choices -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/textbox"
                android:orientation="vertical"
                android:padding="10dp">

                <Button
                    android:id="@+id/answer_a"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/b"
                    android:fontFamily="@font/poppins_medium"
                    android:text="A: x = 1"
                    android:textAlignment="viewStart"
                    android:textColor="@color/black"
                    android:textSize="18sp" />

                <Button
                    android:id="@+id/answer_b"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/b"
                    android:fontFamily="@font/poppins_medium"
                    android:text="B: x = 2"
                    android:textAlignment="viewStart"
                    android:textColor="@color/black"
                    android:textSize="18sp" />

                <Button
                    android:id="@+id/answer_c"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/b"
                    android:fontFamily="@font/poppins_medium"
                    android:text="C: x = 3"
                    android:textAlignment="viewStart"
                    android:textColor="@color/black"
                    android:textSize="18sp" />

                <Button
                    android:id="@+id/answer_d"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/b"
                    android:fontFamily="@font/poppins_medium"
                    android:text="D: x = 4"
                    android:textAlignment="viewStart"
                    android:textColor="@color/black"
                    android:textSize="18sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
